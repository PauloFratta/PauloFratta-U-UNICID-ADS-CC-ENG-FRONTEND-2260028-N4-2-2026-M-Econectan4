{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "EcoConecta (Express / Railway local)",
      "program": "${workspaceFolder}/server.js",
      "env": {
        "PORT": "3000",
        "HOST": "127.0.0.1"
      },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "ouvindo em (https?://\\S+)",
        "uriFormat": "%s/"
      }
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Abrir EcoConecta no Chrome (localhost:3000)",
      "url": "http://127.0.0.1:3000/",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
